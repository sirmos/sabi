# Copy this file to .env and paste your keys. NEVER commit .env (it is in .gitignore).
MODEL_API_KEY=paste-your-meta-model-api-key-here
META_BASE_URL=https://api.meta.ai/v1
SABI_MODEL=muse-spark-1.3
# Who reads the pack labels: meta (Muse Spark) or baseten (Muse Spark Open, open weights)
SABI_PROVIDER=meta
BASETEN_API_KEY=paste-your-baseten-key-here
# mock = canned results, no API calls. live = real calls.
SABI_MODE=live
